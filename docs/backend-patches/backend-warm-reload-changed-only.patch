+# ---------------------------------------------------------------- warm session reload (editor side, with a fake `unreal`)
+
+class WarmReloadTests(unittest.TestCase):
+    """Before each job the warm loop reloads only the mod packages whose files changed since it last matched them (and what
+    references them, and anything modified in memory), not every loaded package."""
+
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp())
+        self.stage = self.tmp / "stage"
+        (self.stage / "Content").mkdir(parents=True)
+        self.loaded = {}
+        self.dirty = set()
+        self.refs = {}            # package -> its referencers
+        self.reloads = []
+        test = self
+
+        class Pkg:
+            def __init__(self, name):
+                self.name = name
+
+            def get_name(self):
+                return self.name
+
+        class Reg:
+            def scan_paths_synchronous(self, paths, force):
+                pass
+
+            def get_referencers(self, name, opts):
+                return list(test.refs.get(name, []))
+
+        fake = types.ModuleType("unreal")
+        fake.AssetRegistryHelpers = types.SimpleNamespace(get_asset_registry=lambda: Reg())
+        fake.AssetRegistryDependencyOptions = lambda **kw: kw
+        fake.EditorAssetLibrary = types.SimpleNamespace(
+            list_assets=lambda root, recursive=True, include_folder=False: ["%s.%s" % (n, n.rsplit("/", 1)[-1]) for n in sorted(test.loaded)])
+        fake.find_package = lambda n: test.loaded.get(n)
+        fake.EditorLoadingAndSavingUtils = types.SimpleNamespace(
+            get_dirty_content_packages=lambda: [test.loaded[n] for n in sorted(test.dirty) if n in test.loaded],
+            reload_packages=lambda pkgs, mode: test.reloads.append(sorted(p.get_name() for p in pkgs)) or True,
+            unload_packages=lambda pkgs: True)
+        fake.ReloadPackagesInteractionMode = types.SimpleNamespace(ASSUME_POSITIVE=1)
+        fake.log = fake.log_error = lambda *a: None
+        self.Pkg = Pkg
+        stub = types.ModuleType("stub")
+        self.patch = mock.patch.dict(sys.modules, {"unreal": fake, "bpkit.core": stub, "bpkit.jobs": stub})
+        self.patch.start()
+        import bpkit
+        self.pkg = bpkit
+        self.saved = {k: getattr(bpkit, k) for k in ("core", "jobs", "warm") if hasattr(bpkit, k)}
+        bpkit.core = bpkit.jobs = stub
+        sys.modules.pop("bpkit.warm", None)
+        self.warm = importlib.import_module("bpkit.warm")
+        for n in ("A", "B", "C"):
+            self.add(n)
+
+    def tearDown(self):
+        self.patch.stop()
+        sys.modules.pop("bpkit.warm", None)
+        for k in ("core", "jobs", "warm"):
+            if k in self.saved:
+                setattr(self.pkg, k, self.saved[k])
+            elif hasattr(self.pkg, k):
+                delattr(self.pkg, k)
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def add(self, n, data=b"v1"):
+        (self.stage / "Content" / (n + ".uasset")).write_bytes(data)
+        self.loaded["/M/" + n] = self.Pkg("/M/" + n)
+
+    def touch(self, n, data):
+        f = self.stage / "Content" / (n + ".uasset")
+        f.write_bytes(data)
+        st = f.stat()
+        os.utime(f, ns=(st.st_atime_ns, st.st_mtime_ns + 5_000_000_000))
+
+    def job(self):
+        r = self.warm.reload_mod("M", str(self.stage))
+        self.warm.remember_synced("M", str(self.stage))
+        return r
+
+    def test_only_changed_packages_and_their_referencers_are_reloaded(self):
+        self.job()
+        self.assertEqual(self.reloads, [["/M/A", "/M/B", "/M/C"]])       # a new session matched nothing yet
+        r = self.job()
+        self.assertEqual(len(self.reloads), 1, "nothing changed: nothing is reloaded")
+        self.assertEqual(r["unchanged"], 3)
+        self.refs["/M/A"] = ["/M/B"]
+        self.touch("A", b"v2 longer")
+        self.job()
+        self.assertEqual(self.reloads[-1], ["/M/A", "/M/B"])             # B references A: rebuilt with it
+        self.dirty.add("/M/C")
+        self.job()
+        self.assertEqual(self.reloads[-1], ["/M/C"])                     # modified in memory
+        self.dirty.clear()
+        self.job()
+        self.assertEqual(len(self.reloads), 4)
+
+    def test_a_package_loaded_by_a_job_is_matched_after_it(self):
+        self.job()
+        self.add("D")                                                     # loaded during a job
+        self.warm.remember_synced("M", str(self.stage))
+        self.job()
+        self.assertEqual(len(self.reloads), 1)
+
+    def test_a_failed_reload_forgets_every_match(self):
+        self.job()
+        self.warm._SYNCED.clear()
+        self.job()
+        self.assertEqual(self.reloads[-1], ["/M/A", "/M/B", "/M/C"])
+
+
 if __name__ == "__main__":
     unittest.main()
