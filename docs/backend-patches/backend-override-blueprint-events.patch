+    def test_override_of_a_blueprint_class_event_is_templated_in_a_child_of_that_class(self):
+        gun = "/Game/Weapons/Gun_ParentBP.Gun_ParentBP_C"
+        with mock.patch.object(self.apply.unreal, "load_class", side_effect=lambda outer, path: "LOADED " + path, create=True):
