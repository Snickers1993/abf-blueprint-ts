+class GameTestUntilTests(unittest.TestCase):
+    """bpkit.gametest with a stubbed `unreal` and a fake clock: until polls a probe, asserts take below/above."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.fake = types.ModuleType("unreal")
+
+        class Object:
+            pass
+
+        class Actor(Object):
+            def __init__(self, name, outer=None):
+                self.name, self.outer = name, outer
+
+            def __str__(self):
+                return "<Object '/Game/Maps/Empty.Empty:PersistentLevel.%s'>" % self.name
+
+            def get_outer(self):
+                return self.outer
+
+        cls.fake.Object, cls.fake.Actor = Object, Actor
+        cls.fake.level_actor = Actor("WorldSettings", outer="LEVEL")
+        cls.fake.ObjectIterator = lambda base: [cls.fake.level_actor]
+        cls.patch = mock.patch.dict(sys.modules, {"unreal": cls.fake})
+        cls.patch.start()
+        for n in ("core", "gametest"):
+            sys.modules.pop("bpkit." + n, None)
+        cls.gt = importlib.import_module("bpkit.gametest")
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.patch.stop()
+        for n in ("core", "gametest"):
+            sys.modules.pop("bpkit." + n, None)
+
+    def run_steps(self, steps):
+        run = tempfile.mkdtemp(prefix="gt", dir=_TMP)
+        clock = [1000.0]
+        with mock.patch.object(self.gt.time, "time", lambda: clock[0]):
+            g = self.gt.game_test({"run": run, "mod": "M", "steps": steps})
+            try:
+                while True:
+                    clock[0] += float(next(g))
+            except StopIteration as e:
+                return e.value, clock[0] - 1000.0
+
+    def test_until_polls_until_the_check_holds(self):
+        count = "ctx['n'] = ctx.get('n', 0) + 1\nresult = ctx['n']"
+        res, waited = self.run_steps([{"op": "until", "probe": {"op": "python", "code": count}, "above": 3, "timeout": 10, "every": 0.5}])
+        self.assertEqual(res["steps"][0], {"i": 0, "op": "until", "ok": True, "value": 4})
+        self.assertAlmostEqual(waited, 1.5)
+
+    def test_until_fails_with_the_last_value_after_the_timeout(self):
+        res, waited = self.run_steps([{"op": "until", "probe": {"op": "python", "code": "result = 7"}, "equals": 9, "timeout": 2, "every": 0.5}])
+        self.assertEqual(res["steps"][0], {"i": 0, "op": "until", "ok": False, "value": 7})
+        self.assertEqual(res["failed"], 1)
+        self.assertAlmostEqual(waited, 2.0)
+
+    def test_until_retries_a_probe_that_raises_and_reports_its_error_at_the_end(self):
+        res, _ = self.run_steps([{"op": "until", "probe": {"op": "get", "target": "$nothing", "property": "Step"}, "equals": 1, "timeout": 1}])
+        self.assertFalse(res["steps"][0]["ok"])
+        self.assertIn("KeyError", res["steps"][0]["error"])
+
+    def test_until_refuses_a_bad_probe_or_no_check(self):
+        res, _ = self.run_steps([{"op": "until", "probe": {"op": "wait", "seconds": 1}, "equals": 1},
+                                 {"op": "until", "probe": {"op": "python", "code": "result = 1"}}])
+        self.assertEqual([r["ok"] for r in res["steps"]], [False, False])
+        self.assertIn("call, get or python", res["steps"][0]["error"])
+
+    def test_assert_below_and_above(self):
+        res, _ = self.run_steps([{"op": "python", "code": "result = 5.0", "as": "d"},
+                                 {"op": "assert", "value": "$d", "below": 6}, {"op": "assert", "value": "$d", "below": 5},
+                                 {"op": "assert", "value": "$d", "above": 4}, {"op": "assert", "value": "$d", "above": 5}])
+        self.assertEqual([r["ok"] for r in res["steps"]], [True, True, False, True, False])
+
+    def test_the_map_wait_uses_load_timeout(self):
+        run = tempfile.mkdtemp(prefix="gt", dir=_TMP)
+        clock = [0.0]
+        with mock.patch.object(self.gt.time, "time", lambda: clock[0]), \
+                mock.patch.object(self.fake, "ObjectIterator", lambda base: []):
+            g = self.gt.game_test({"run": run, "mod": "M", "map": "/Game/Maps/Facility", "load_timeout": 300, "steps": []})
+            with self.assertRaises(RuntimeError) as cm:
+                while True:
+                    clock[0] += float(next(g))
+        self.assertIn("within 300 s", str(cm.exception))
+        self.assertGreater(clock[0], 300)
+
+
