+CHECKS = ("equals", "approx", "contains", "truthy", "not_none", "below", "above")
+PROBE_OPS = ("call", "get", "python")
+
+
+def check(step, v):
+    """True when value v passes the assert keys of step (an assert or an until step)."""
+    if "equals" in step:
+        return v == step["equals"]
+    if "approx" in step:
+        return abs(float(v) - float(step["approx"])) <= float(step.get("tolerance", 0.01))
+    if "contains" in step:
+        return step["contains"] in (v if isinstance(v, (str, list, tuple)) else str(v))
+    if "truthy" in step:
+        return bool(v) == bool(step["truthy"])
+    if "not_none" in step:
+        return (v is not None) == bool(step["not_none"])
+    if "below" in step:
+        return v is not None and float(v) < float(step["below"])
+    if "above" in step:
+        return v is not None and float(v) > float(step["above"])
+    raise ValueError("assert needs equals, approx, contains, truthy, not_none, below or above")
+
+
