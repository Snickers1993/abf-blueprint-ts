     if ued.get_game_world() is not None:
         return {"refused": pkgs, "reason": "Play In Editor is running"}
+    limit = args.get("max_live_instances")
+    limit = _MAX_LIVE_INSTANCES if limit is None else int(limit)
+    if limit > 0:
+        n, by = _live_instances(pkgs)
+        if n > limit:
+            top = ", ".join("%s x%d" % (p.rsplit("/", 1)[-1], c) for p, c in sorted(by.items(), key=lambda kv: -kv[1])[:5])
+            return {"refused": sorted(by), "live_instances": n,
+                    "reason": "%d live instances of the published classes are in the open level (%s), more than %d; swapping "
+                              "their classes live can crash the editor" % (n, top, limit)}
     dirty = {p.get_name() for p in unreal.EditorLoadingAndSavingUtils.get_dirty_content_packages()}
     hit = [p for p in pkgs if p in dirty]
     hit_refs = [p for p in refs if p in dirty]
