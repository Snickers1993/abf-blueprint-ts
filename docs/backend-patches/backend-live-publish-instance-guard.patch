+class LivePublishInstanceGuardTests(unittest.TestCase):
+    """A live publish refuses to swap classes that many actors of the open level use (it crashed the editor once)."""
+
+    def setUp(self):
+        self.actors = []
+        test = self
+
+        class Actor:
+            def __init__(self, path):
+                self.path = path
+
+            def get_class(self):
+                return types.SimpleNamespace(get_path_name=lambda: self.path)
+
+        self.Actor = Actor
+        fake = types.ModuleType("unreal")
+        fake.UnrealEditorSubsystem = "ued"
+        fake.EditorActorSubsystem = "actors"
+        subs = {"ued": types.SimpleNamespace(get_game_world=lambda: None),
+                "actors": types.SimpleNamespace(get_all_level_actors=lambda: list(test.actors))}
+        fake.get_editor_subsystem = lambda cls: subs[cls]
+        fake.EditorLoadingAndSavingUtils = types.SimpleNamespace(get_dirty_content_packages=lambda: [])
+        fake.AssetRegistryHelpers = types.SimpleNamespace(get_asset_registry=lambda: types.SimpleNamespace(get_referencers=lambda n, o: []))
+        fake.AssetRegistryDependencyOptions = lambda **kw: kw
+        self.patch = mock.patch.dict(sys.modules, {"unreal": fake})
+        self.patch.start()
+        import bpkit
+        self.pkg = bpkit
+        self.saved = getattr(bpkit, "livepublish", None)
+        sys.modules.pop("bpkit.livepublish", None)
+        self.lp = importlib.import_module("bpkit.livepublish")
+
+    def tearDown(self):
+        self.patch.stop()
+        sys.modules.pop("bpkit.livepublish", None)
+        if self.saved is not None:
+            self.pkg.livepublish = self.saved
+        elif hasattr(self.pkg, "livepublish"):
+            delattr(self.pkg, "livepublish")
+
+    def test_many_live_instances_refuse_before_anything_is_unloaded(self):
+        self.actors = [self.Actor("/M/BP_Desk.BP_Desk_C")] * 250 + [self.Actor("/M/BP_Lamp.BP_Lamp_C")] * 100 + [self.Actor("/Game/X.X_C")] * 900
+        r = self.lp.prepare({"root": "/M", "packages": ["/M/BP_Desk", "/M/BP_Lamp", "/M/BP_Other"]})
+        self.assertEqual(r["live_instances"], 350)
+        self.assertEqual(r["refused"], ["/M/BP_Desk", "/M/BP_Lamp"])
+        self.assertIn("live instances", r["reason"])
+        self.assertIn("BP_Desk x250", r["reason"])
+
+    def test_the_limit_can_be_raised_or_switched_off(self):
+        self.actors = [self.Actor("/M/BP_Desk.BP_Desk_C")] * 350
+        n, by = self.lp._live_instances(["/M/BP_Desk"])
+        self.assertEqual((n, by), (350, {"/M/BP_Desk": 350}))
+        past = types.SimpleNamespace(get_dirty_content_packages=mock.Mock(side_effect=RuntimeError("past the guard")))
+        with mock.patch.object(self.lp.unreal, "EditorLoadingAndSavingUtils", past):
+            for limit in (400, 0):
+                with self.assertRaisesRegex(RuntimeError, "past the guard"):
+                    self.lp.prepare({"root": "/M", "packages": ["/M/BP_Desk"], "max_live_instances": limit})
+
+
 if __name__ == "__main__":
     unittest.main()
