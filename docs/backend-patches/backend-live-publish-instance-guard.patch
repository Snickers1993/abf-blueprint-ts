+# More live instances of the swapped classes than this in the open level: the class swap of a live publish is refused (one
+# publish of 41 classes with about 1,140 preview actors in the level crashed the editor). `max_live_instances` overrides it;
+# 0 means no limit.
+_MAX_LIVE_INSTANCES = 300
+
+
+def _live_instances(pkgs):
+    """Actors in the open level whose class lives in one of `pkgs`: (count, {package: count})."""
+    names, by = set(pkgs), {}
+    try:
+        actors = unreal.get_editor_subsystem(unreal.EditorActorSubsystem).get_all_level_actors()
+    except Exception:
+        return 0, by
+    for a in actors or []:
+        try:
+            p = str(a.get_class().get_path_name()).split(".")[0]
+        except Exception:
+            continue
+        if p in names:
+            by[p] = by.get(p, 0) + 1
+    return sum(by.values()), by
+
+
 def prepare(args):
