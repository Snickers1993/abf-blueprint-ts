index 6a77ac8..d549773 100644
--- a/staging.py
+++ b/staging.py
@@ -181,6 +181,50 @@ def sync(mod_dir, discard_changes=False, forbidden=()):
     return stage
 
 
+def refresh(mod):
+    """Brings an existing stage up to the real mod without discarding it: copies the files the stage never touched that the real
+    mod saved since the sync (diff()'s stale list), removes the ones it deleted, and copies real files the stage never had.
+    Files the stage changed or added (unpublished work) are kept. Refuses on a conflict (a file changed on both sides): that
+    needs staging_sync with discard_changes. The sync time stays: the stage still holds the work it held."""
+    stage = load(mod)
+    meta = _upgrade_baseline(stage, stage.meta())
+    if not meta.get("source_dir"):
+        raise StagingError("the stage of %s does not record its real mod folder: run staging_sync" % mod)
+    src = Path(meta["source_dir"])
+    if not src.is_dir():
+        raise StagingError("the real mod folder %s is gone: run staging_sync" % src)
+    d = diff(stage)
+    if d["conflicts"]:
+        raise StagingError("staging of %s conflicts with the real mod (%s): run staging_sync with discard_changes"
+                           % (mod, ", ".join(c["path"] for c in d["conflicts"][:5])))
+    base = meta.setdefault("baseline", {})
+    known = set(_tracked_files(stage.dir)) | set(base)
+    copied, removed = [], []
+    for rel in d["stale"]:
+        real, dst = src / rel, stage.dir / rel
+        if real.is_file():
+            dst.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(real, dst)
+            base[rel] = {"sha256": _sha(dst), "size": dst.stat().st_size}
+            copied.append(rel)
+        else:
+            if dst.exists():
+                dst.unlink()
+            base.pop(rel, None)
+            removed.append(rel)
+    for rel in _tracked_files(src):
+        if rel in known:
+            continue
+        dst = stage.dir / rel
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(src / rel, dst)
+        base[rel] = {"sha256": _sha(dst), "size": dst.stat().st_size}
+        copied.append(rel)
+    meta["refreshed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
+    stage.save_meta(meta)
+    return {"copied": sorted(copied), "removed": sorted(removed)}
+
+
 def load(mod):
     stage = Stage(mod)
     if not stage.meta_path.is_file() or not stage.dir.is_dir():
