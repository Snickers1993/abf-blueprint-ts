+    def test_refresh_copies_only_what_the_real_mod_changed_and_keeps_staged_edits(self):
+        self.stage_write("Content/Sub/B.uasset", b"staged edit")              # unpublished work in the stage
+        (self.real / "Content" / "A.uasset").write_bytes(b"saved in the Mod Editor")
+        (self.real / "Content" / "M_New.uasset").write_bytes(b"new material")
+        synced = self.stage.meta()["synced_at"]
+        r = staging.refresh("Fake")
+        self.assertEqual(r, {"copied": ["Content/A.uasset", "Content/M_New.uasset"], "removed": []})
+        self.assertEqual((self.stage.dir / "Content" / "A.uasset").read_bytes(), b"saved in the Mod Editor")
+        self.assertEqual((self.stage.dir / "Content" / "M_New.uasset").read_bytes(), b"new material")
+        self.assertEqual((self.stage.dir / "Content" / "Sub" / "B.uasset").read_bytes(), b"staged edit")
+        d = staging.diff(self.stage)
+        self.assertEqual((d["stale"], d["conflicts"], d["changed"], d["added"]), ([], [], ["Content/Sub/B.uasset"], []))
+        self.assertEqual(self.stage.meta()["synced_at"], synced)
+        # a file deleted in the real mod goes from the stage too
+        (self.real / "Content" / "A.uasset").unlink()
+        self.assertEqual(staging.refresh("Fake"), {"copied": [], "removed": ["Content/A.uasset"]})
+        self.assertFalse((self.stage.dir / "Content" / "A.uasset").exists())
+        self.assertEqual(staging.diff(self.stage)["removed"], [])
+
+    def test_refresh_refuses_a_conflict(self):
+        self.stage_write("Content/A.uasset", b"staged edit")
+        (self.real / "Content" / "A.uasset").write_bytes(b"saved in the Mod Editor")
+        with self.assertRaises(staging.StagingError) as cm:
+            staging.refresh("Fake")
+        self.assertIn("conflicts", str(cm.exception))
+        self.assertEqual((self.stage.dir / "Content" / "A.uasset").read_bytes(), b"staged edit")
+
