+# Jobs that only read: after them every loaded, unmodified package still matches its file.
+READ_ONLY_OPS = ("export", "reflect", "catalog")
+# Asset classes no job changes in memory (prefixes of the class name): they keep their match after any job.
+_PLAIN_DATA = ("Sound", "Texture", "StaticMesh", "SkeletalMesh", "Material", "Niagara", "Anim", "PhysicsAsset", "Skeleton",
+               "Font", "Curve", "MediaSource", "FileMediaSource")
+
+
+def _plain_data(name):
+    try:
+        obj = unreal.find_object(None, "%s.%s" % (name, name.rsplit("/", 1)[-1]))
+        cls = obj.get_class().get_name() if obj is not None else ""
+    except Exception:
+        return False
+    return any(cls.startswith(p) for p in _PLAIN_DATA)
+
+
+def remember_synced(mod, stage_dir, op="export"):
     """After a job that finished: every loaded package of the mod that is not modified in memory matches its file now (it was
-    loaded or reloaded from it, or the job saved it). Their stats let the next job skip their reload."""
+    loaded or reloaded from it, or the job saved it). Their stats let the next job skip their reload. After a job that
+    changes Blueprints (apply, compile, asset_ops), a Blueprint, level or data table can differ from its file without being
+    marked modified (the compile reconstructs nodes in memory): only plain data (sounds, meshes, textures, materials) keeps
+    its match, everything else is reloaded by the next job, as it always was."""
     if not stage_dir:
         return
     dirty = _dirty_names()
+    read_only = op in READ_ONLY_OPS
     for name in _mod_packages(mod):
-        if name in dirty or unreal.find_package(name) is None:
+        if name in dirty or unreal.find_package(name) is None or (not read_only and not _plain_data(name)):
             _SYNCED.pop(name, None)
             continue
         f = _package_file(stage_dir, mod, name)
@@ -211,7 +231,7 @@ def run_entry(entry, stage_dir):
