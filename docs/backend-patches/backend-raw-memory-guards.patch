+class _MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p), ("AllocationProtect", ctypes.c_ulong),
+                ("PartitionId", ctypes.c_ushort), ("RegionSize", ctypes.c_size_t), ("State", ctypes.c_ulong),
+                ("Protect", ctypes.c_ulong), ("Type", ctypes.c_ulong)]
+
+
+_READ_OK = 0x02 | 0x04 | 0x08 | 0x20 | 0x40 | 0x80  # PAGE_READONLY .. PAGE_EXECUTE_WRITECOPY
+_VQ = None
+
+
+def readable(a, n):
+    """True when [a, a+n) is committed, readable memory of this process. A candidate pointer found by scanning raw
+    bytes can be any number; reading through it unchecked is an access violation that kills the editor."""
+    global _VQ
+    if n <= 0:
+        return True
+    if _VQ is None:
+        k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        k32.VirtualQuery.argtypes = [ctypes.c_void_p, ctypes.POINTER(_MBI), ctypes.c_size_t]
+        k32.VirtualQuery.restype = ctypes.c_size_t
+        _VQ = k32.VirtualQuery
+    end, cur = a + n, a
+    while cur < end:
+        m = _MBI()
+        if not _VQ(ctypes.c_void_p(cur), ctypes.byref(m), ctypes.sizeof(m)):
+            return False
+        if m.State != 0x1000 or not (m.Protect & _READ_OK) or (m.Protect & 0x100):  # MEM_COMMIT, readable, not PAGE_GUARD
+            return False
+        cur = (m.BaseAddress or 0) + m.RegionSize
+    return True
+
