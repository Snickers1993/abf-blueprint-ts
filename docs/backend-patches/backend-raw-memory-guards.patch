+def _counted_offsets(obj, n, span):
+    """Offsets in [0x28, span) of obj holding a TArray header with count n whose buffer is readable."""
+    b = rd(addr(obj), span + 16)
+    hits = []
+    for o in range(0x28, span, 8):
+        p, c, m = struct.unpack_from("<Qii", b, o)
+        if c == n and m >= c and 0x10000 < p < 0x7fffffffffff and readable(p, 8):
+            hits.append(o)
+    return hits
+
+
+def _probe_offset(make, counts, span, what):
+    """The one offset where a probe of every count in `counts` shows that count. A single probe can match a stray
+    triple (another array of the same size, or bytes past the end of the object); a second size rules those out."""
+    common = None
+    for n in counts:
+        hits = set(_counted_offsets(make(n), n, span))
+        common = hits if common is None else common & hits
+        if len(common) == 1:
+            return common.pop()
+        if not common:
+            break
+    raise RuntimeError("%s offset ambiguous %s" % (what, sorted(common or [])))
+
