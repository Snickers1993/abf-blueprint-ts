+# ---------------------------------------------------------------- raw memory guards (editor side, with a fake `unreal`)
+
+class RawMemoryGuardTests(unittest.TestCase):
+    """The raw TArray scans read through numbers found in object memory; a number that only looks like a pointer
+    must be skipped, not read (an access violation kills the editor), and a stray count match must not make the
+    array offset ambiguous."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.fake = types.ModuleType("unreal")
+        for n in ("BlueprintEditorLibrary", "EdGraphNode", "Blueprint"):
+            setattr(cls.fake, n, type(n, (), {}))
+        cls.patch = mock.patch.dict(sys.modules, {"unreal": cls.fake})
+        cls.patch.start()
+        sys.modules.pop("bpkit.core", None)
+        import bpkit
+        cls.pkg = bpkit
+        cls.saved = getattr(bpkit, "core", None)
+        cls.core = importlib.import_module("bpkit.core")
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.patch.stop()
+        sys.modules.pop("bpkit.core", None)
+        if cls.saved is not None:
+            cls.pkg.core = cls.saved
+        elif hasattr(cls.pkg, "core"):
+            delattr(cls.pkg, "core")
+
+    @unittest.skipUnless(sys.platform == "win32", "VirtualQuery is Windows-only")
+    def test_readable_tells_live_memory_from_a_fake_pointer(self):
+        import ctypes
+        buf = ctypes.create_string_buffer(64)
+        self.assertTrue(self.core.readable(ctypes.addressof(buf), 64))
+        k32 = ctypes.WinDLL("kernel32")
+        k32.VirtualAlloc.restype = ctypes.c_void_p
+        k32.VirtualAlloc.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_ulong, ctypes.c_ulong]
+        k32.VirtualFree.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_ulong]
+        reserved = k32.VirtualAlloc(None, 0x10000, 0x2000, 0x01)  # MEM_RESERVE, PAGE_NOACCESS: mapped but unreadable
+        try:
+            self.assertFalse(self.core.readable(reserved, 8))
+        finally:
+            k32.VirtualFree(reserved, 0, 0x8000)
+
+    @unittest.skipUnless(sys.platform == "win32", "VirtualQuery is Windows-only")
+    def test_nodes_array_skips_a_triple_whose_pointer_is_not_readable(self):
+        import ctypes, struct
+        k32 = ctypes.WinDLL("kernel32")
+        k32.VirtualAlloc.restype = ctypes.c_void_p
+        k32.VirtualAlloc.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_ulong, ctypes.c_ulong]
+        k32.VirtualFree.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_ulong]
+        bad = k32.VirtualAlloc(None, 0x10000, 0x2000, 0x01)
+        try:
+            nodes = (ctypes.c_uint64 * 2)(0x111110, 0x222220)
+            graph = ctypes.create_string_buffer(0x180)
+            struct.pack_into("<Qii", graph, 0x30, bad, 2, 2)                          # looks like a 2-element array
+            struct.pack_into("<Qii", graph, 0x60, ctypes.addressof(nodes), 2, 4)     # the real nodes array
+            with mock.patch.object(self.core, "addr", lambda g: ctypes.addressof(graph)):
+                off, ptrs = self.core.nodes_array(object(), {0x111110, 0x222220})
+            self.assertEqual((off, ptrs), (0x60, [0x111110, 0x222220]))
+        finally:
+            k32.VirtualFree(bad, 0, 0x8000)
+
+    def test_probe_offset_uses_a_second_count_to_rule_out_a_stray_match(self):
+        seen = {23: [448, 1488], 37: [448, 960]}
+        with mock.patch.object(self.core, "_counted_offsets", lambda obj, n, span: seen[obj]):
+            self.assertEqual(self.core._probe_offset(lambda n: n, (23, 37), 0x5f0, "NewVariables"), 448)
+
+    def test_probe_offset_still_raises_when_both_counts_disagree(self):
+        seen = {23: [448, 1488], 37: [960]}
+        with mock.patch.object(self.core, "_counted_offsets", lambda obj, n, span: seen[obj]):
+            with self.assertRaisesRegex(RuntimeError, "NewVariables offset ambiguous"):
+                self.core._probe_offset(lambda n: n, (23, 37), 0x5f0, "NewVariables")
+
+    def test_probe_offset_needs_one_probe_when_the_first_is_unique(self):
+        calls = []
+
+        def make(n):
+            calls.append(n)
+            return n
+        with mock.patch.object(self.core, "_counted_offsets", lambda obj, n, span: [448]):
+            self.assertEqual(self.core._probe_offset(make, (23, 37), 0x5f0, "NewVariables"), 448)
+        self.assertEqual(calls, [23])
+
+
