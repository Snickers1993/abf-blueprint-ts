     return core.adopt_graphs(ib, [name], bp)
 
 
+_FN_FLAGS_OFF = []   # [offset of UFunction::FunctionFlags] once found, [None] when it cannot be found
+
+
+def _fn_obj(class_path, fn):
+    return unreal.find_object(None, "%s:%s" % (class_path, fn))
+
+
+def _fn_flags_off():
+    """Offset of FunctionFlags in a UFunction, found on three native functions whose flags are known in part
+    (an implementable event, a native callable, a static native callable). None when it is not unique."""
+    if _FN_FLAGS_OFF:
+        return _FN_FLAGS_OFF[0]
+    off = None
+    try:
+        probes = [
+            (_fn_obj("/Script/Engine.Actor", "ReceiveBeginPlay"), 0x08000800, 0x08000800),             # Event | BlueprintEvent
+            (_fn_obj("/Script/Engine.Actor", "K2_DestroyActor"), 0x0C000400, 0x04000400),              # Native | BlueprintCallable, no BlueprintEvent
+            (_fn_obj("/Script/Engine.KismetSystemLibrary", "PrintString"), 0x0C002400, 0x04002400),    # Static | Native | BlueprintCallable
+        ]
+        if all(p[0] is not None for p in probes):
+            mem = [(rd(addr(o), 0x140), mask, want) for o, mask, want in probes]
+            hits = []
+            for o in range(0x60, 0x13c, 4):
+                ok = True
+                for b, mask, want in mem:
+                    v = struct.unpack_from("<I", b, o)[0]
+                    if (v & mask) != want or (v & t3d.ACCESS_MASK) not in t3d.ACCESS_FLAGS.values():
+                        ok = False
+                        break
+                if ok:
+                    hits.append(o)
+            if len(hits) == 1:
+                off = hits[0]
+    except Exception:  # noqa: BLE001
+        off = None
+    _FN_FLAGS_OFF.append(off)
+    return off
+
+
+def parent_fn_access(class_path, fn):
+    """"public" | "protected" | "private" of the function `fn` declared by `class_path` (an override's entry must carry the same
+    access specifier, else the compile fails with "Access specifier is not compatible the parent function"). None when unknown."""
+    try:
+        off = _fn_flags_off()
+        cls = unreal.load_class(None, class_path)
+        o = _fn_obj(class_path, fn) if cls is not None else None
+        if off is None or o is None:
+            return None
+        v = struct.unpack_from("<I", rd(addr(o) + off, 4))[0] & t3d.ACCESS_MASK
+        for name, bit in t3d.ACCESS_FLAGS.items():
+            if v == bit:
+                return name
+    except Exception:  # noqa: BLE001
+        pass
+    return None
+
+
 def add_function_override(bp, name, defs):
     """Append a function graph that overrides the parent's function `name` (its entry and result carry MemberParent)."""
     elem = "\"/Script/Engine.EdGraph'BkG0'\""
