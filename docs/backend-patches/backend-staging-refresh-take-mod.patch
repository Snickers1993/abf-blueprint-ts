+    def test_refresh_takes_the_real_file_of_a_listed_conflict_and_keeps_other_staged_edits(self):
+        self.stage_write("Content/A.uasset", b"staged edit")
+        self.stage_write("Content/Sub/B.uasset", b"other staged edit")
+        (self.real / "Content" / "A.uasset").write_bytes(b"saved in the Mod Editor")
+        r = staging.refresh("Fake", take_mod=["Content/A.uasset"])
+        self.assertEqual(r["copied"], ["Content/A.uasset"])
+        self.assertEqual((self.stage.dir / "Content" / "A.uasset").read_bytes(), b"saved in the Mod Editor")
+        self.assertEqual((self.stage.dir / "Content" / "Sub" / "B.uasset").read_bytes(), b"other staged edit")
+        d = staging.diff(self.stage)
+        self.assertEqual(d["conflicts"], [])
+        self.assertEqual(d["changed"], ["Content/Sub/B.uasset"])
+
+    def test_refresh_still_refuses_a_conflict_it_was_not_told_to_take(self):
+        self.stage_write("Content/A.uasset", b"staged edit")
+        self.stage_write("Content/Sub/B.uasset", b"other staged edit")
+        (self.real / "Content" / "A.uasset").write_bytes(b"saved")
+        (self.real / "Content" / "Sub" / "B.uasset").write_bytes(b"saved too")
+        with self.assertRaises(staging.StagingError):
+            staging.refresh("Fake", take_mod=["Content/A.uasset"])
+        self.assertEqual((self.stage.dir / "Content" / "A.uasset").read_bytes(), b"staged edit")
