+def _old_copies(names):
+    """Packages of `names` whose old version from an earlier reload in this editor session is still in memory after a garbage
+    collection: a package renamed to `<name>_DEADPACKAGE...`, or a class `TRASHCLASS_<Name>_C...` / `REINST_<Name>_C...`.
+    Something (a Python global, a bound delegate, an actor of a preview) still holds it, and reloading the same package again
+    while it does is the one difference known between a live publish that worked and the next one, of the same classes in
+    the same session, that crashed the editor (20 Nov). {package: [old object names]}."""
+    by_short = {}
+    for n in names:
+        by_short.setdefault(_short(n), n)
+    found = {}
+    prefixes = []
+    for sh, n in by_short.items():
+        prefixes += [("TRASHCLASS_%s_C" % sh, n), ("REINST_%s_C" % sh, n)]
+    try:
+        for c in unreal.ObjectIterator(unreal.Class):
+            try:
+                cn = c.get_name()
+            except Exception:
+                continue
+            if not cn.startswith(("TRASHCLASS_", "REINST_")):
