+def _step(backup, step, **data):
+    """Append one live publish step to `publish-steps.jsonl` in the backup folder, written by the server before and after each
+    call into the open editor, so an editor that stops answering (or crashes) leaves a record of the step it was in. Never raises."""
+    if backup is None:
+        return
+    try:
+        line = json.dumps(dict(step=step, at=time.strftime("%Y-%m-%dT%H:%M:%S"), **data), default=str)
+        with open(Path(backup) / "publish-steps.jsonl", "a", encoding="utf-8") as f:
+            f.write(line + "\n")
+    except Exception:
+        pass
+
+
