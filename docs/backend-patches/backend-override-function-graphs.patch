     for f in spec.get("functions") or []:
         if LIB.find_graph(bp, f["name"]):
             raise RuntimeError("function graph %s already exists; list it in remove_functions to replace it" % f["name"])
+        if f.get("override"):
+            # an override of a parent function with outputs: entry and result name the parent; the graph joins FunctionGraphs
+            defs = [n.defn() for n in _fn_nodes(f, parent=env.class_text(f["override"]), editable=False)]
+            assets.add_function_override(bp, f["name"], defs)
