diff --git a/editor/bpkit/assets.py b/editor/bpkit/assets.py
index 3971d76..80fb6eb 100644
--- a/editor/bpkit/assets.py
+++ b/editor/bpkit/assets.py
@@ -174,6 +174,14 @@ def add_macro(bp, name, defs, guid):
     return core.adopt_graphs(ib, [name], bp)
 
 
+def add_function_override(bp, name, defs):
+    """Append a function graph that overrides the parent's function `name` (its entry and result carry MemberParent)."""
+    elem = "\"/Script/Engine.EdGraph'BkG0'\""
+    off = core.bp_arr_off(bp, "FunctionGraphs", elem, '      Begin Object Class=/Script/Engine.EdGraph Name="BkG0"\n      End Object\n')
+    ib = core.array_append(bp, "FunctionGraphs", off, t3d.graph_obj(name, defs), ["\"/Script/Engine.EdGraph'%s'\"" % name])
+    return core.adopt_graphs(ib, [name], bp)
+
+
 def add_interface(bp, iface_class, graphs_text, names):
     """Append an ImplementedInterfaces entry (FBPInterfaceDescription: 8 + 16 bytes) keeping the existing ones."""
     ie = "(Interface=\"/Script/Engine.BlueprintGeneratedClass'%s'\")" % iface_class
