diff --git a/tests/test_zen_flag.py b/tests/test_zen_flag.py
new file mode 100644
index 0000000..4796780
--- /dev/null
+++ b/tests/test_zen_flag.py
@@ -0,0 +1,36 @@
+"""headless.zen_args: hidden runs pass -NoZenAutoLaunch only while a zenserver is already running."""
+import os
+import socket
+import sys
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import headless  # noqa: E402
+
+
+class ZenFlagTests(unittest.TestCase):
+    def test_flag_only_while_a_server_answers(self):
+        srv = socket.socket()
+        srv.bind(("127.0.0.1", 0))
+        srv.listen(1)
+        port = srv.getsockname()[1]
+        try:
+            with mock.patch.dict(os.environ, {"ABF_ZEN_PORT": str(port), "ABF_ZEN_AUTOLAUNCH": ""}):
+                self.assertEqual(headless.zen_args(), ["-NoZenAutoLaunch"])
+        finally:
+            srv.close()
+        with mock.patch.dict(os.environ, {"ABF_ZEN_PORT": str(port), "ABF_ZEN_AUTOLAUNCH": ""}):
+            self.assertEqual(headless.zen_args(), [], "no server: the editor may start its own, else the run has no derived data")
+
+    def test_the_environment_can_force_either_way(self):
+        with mock.patch.object(headless, "zen_running", return_value=False), mock.patch.dict(os.environ, {"ABF_ZEN_AUTOLAUNCH": "never"}):
+            self.assertEqual(headless.zen_args(), ["-NoZenAutoLaunch"])
+        with mock.patch.object(headless, "zen_running", return_value=True), mock.patch.dict(os.environ, {"ABF_ZEN_AUTOLAUNCH": "always"}):
+            self.assertEqual(headless.zen_args(), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
