     return run
 
 
+ZEN_PORT_DEFAULT = 8558
+
+
+def zen_running():
+    """True when a zenserver already answers on the local Zen port (ABF_ZEN_PORT, default 8558): a TCP connect, no request."""
+    import socket
+    try:
+        port = int(os.environ.get("ABF_ZEN_PORT") or ZEN_PORT_DEFAULT)
+    except ValueError:
+        port = ZEN_PORT_DEFAULT
+    try:
+        with socket.create_connection(("127.0.0.1", port), timeout=0.5):
+            return True
+    except OSError:
+        return False
+
+
+def zen_args():
+    """["-NoZenAutoLaunch"] when a zenserver is already running, else []. With a server running, a hidden run must use it and
+    never start its own: its redirected LOCALAPPDATA once made it install and start a second zenserver on the default port, the
+    user's shared Zen store was recreated and mod meshes stopped drawing in Play. With none running, the flag would leave the run
+    without derived data (bp_read failed with ABFC4002), so the editor's own auto-launch is kept. ABF_ZEN_AUTOLAUNCH=never
+    always passes the flag, =always never does."""
+    mode = (os.environ.get("ABF_ZEN_AUTOLAUNCH") or "").strip().lower()
+    if mode == "never":
+        return ["-NoZenAutoLaunch"]
+    if mode == "always":
+        return []
+    return ["-NoZenAutoLaunch"] if zen_running() else []
+
+
