+# ---- field-default values (abfc): JSON {"k": kind, ...} -> Unreal values; no program text is evaluated -----------------
+
+_PY_SPLIT = re.compile(r"(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])")
+
+
+def set_prop(o, n, v):
+    """Set by the Unreal property name, then by the Python name Unreal derives from it (bHidden -> hidden, RelativeLocation -> relative_location)."""
+    try:
+        o.set_editor_property(n, v)
+    except Exception:  # noqa: BLE001
+        p = n[1:] if re.match(r"^b[A-Z]", n) else n
+        o.set_editor_property(_PY_SPLIT.sub("_", p).lower(), v)
+
+
+def field_value(v):
+    k = v["k"]
+    if k == "none":
+        return None
+    if k in ("bool", "num", "str"):
+        return v["v"]
+    if k == "name":
+        return unreal.Name(v["v"])
+    if k == "text":
+        return unreal.Text(v["v"])
+    if k == "asset":
+        return must(unreal.load_asset(v["path"]), "asset " + v["path"])
+    if k == "class":
+        return must(unreal.load_class(None, v["path"]), "class " + v["path"])
+    if k == "struct":
+        s = must(getattr(unreal, v["name"], None), "struct type unreal." + v["name"])()
+        for f, x in v["fields"].items():
+            set_prop(s, f, field_value(x))
+        return s
+    if k == "array":
+        return [field_value(x) for x in v["items"]]
+    raise RuntimeError("field value kind %s" % k)
+
+
 def add_components(bp, items):
