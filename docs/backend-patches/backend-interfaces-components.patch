index 536db61..1d69da3 100644
--- a/editor/bpkit/specs.py
+++ b/editor/bpkit/specs.py
@@ -128,8 +128,41 @@ REQUIRED = {
 CREATE_CLASSES = ("Blueprint", "WidgetBlueprint", "BlueprintInterface", "UserDefinedStruct")
 RAW_KINDS = ("graph", "tree", "tree_replace", "python")
 # bp_apply features reported by the backend_info tool
-FEATURES = ("cast_object_pin", "class_manager_row", "class_manager_row_tag", "event_meta", "function_graphs", "map_types", "override_functions", "pin_types", "self_event_calls",
-            "set_types", "struct_fields", "variable_defaults")
+FEATURES = ("cast_object_pin", "class_manager_row", "class_manager_row_tag", "components", "event_meta", "function_graphs", "interfaces", "map_types", "override_functions",
+            "pin_types", "self_event_calls", "set_types", "struct_fields", "variable_defaults")
+_VALUE_KINDS = ("none", "bool", "num", "str", "name", "text", "asset", "class", "struct", "array")
+_VALUE_PATH = re.compile(r"^/[A-Za-z0-9_]+(/[A-Za-z0-9_]+)+(\.[A-Za-z0-9_]+)?$")
+_VALUE_IDENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
+
+
+def check_value(v, where, depth=0):
+    """Problems of an abfc field-default JSON value (assets.field_value)."""
+    if depth > 8 or not isinstance(v, dict) or v.get("k") not in _VALUE_KINDS:
+        return ["%s: not a value {k: %s}" % (where, "|".join(_VALUE_KINDS))]
+    k = v["k"]
+    if k == "bool" and not isinstance(v.get("v"), bool):
+        return [where + ": bool needs v true/false"]
+    if k == "num" and (isinstance(v.get("v"), bool) or not isinstance(v.get("v"), (int, float))):
+        return [where + ": num needs a number v"]
+    if k in ("str", "name", "text") and not isinstance(v.get("v"), str):
+        return [where + ": %s needs a string v" % k]
+    if k in ("asset", "class") and not (isinstance(v.get("path"), str) and _VALUE_PATH.match(v["path"])):
+        return [where + ": %s needs a plain object path" % k]
+    if k == "struct":
+        if not (isinstance(v.get("name"), str) and _VALUE_IDENT.match(v["name"]) and isinstance(v.get("fields"), dict)):
+            return [where + ": struct needs name and fields"]
+        out = []
+        for f, x in v["fields"].items():
+            out += ([] if _VALUE_IDENT.match(f) else ["%s: bad struct field %r" % (where, f)]) + check_value(x, "%s.%s" % (where, f), depth + 1)
+        return out
+    if k == "array":
+        if not isinstance(v.get("items"), list):
+            return [where + ": array needs items"]
+        out = []
+        for i, x in enumerate(v["items"]):
+            out += check_value(x, "%s[%d]" % (where, i), depth + 1)
+        return out
+    return []
 EVENT_META_KEYS = ("tooltip", "category", "keywords")
 EVENT_META_MAX = 2000
 # keys that make no sense on a UserDefinedStruct asset
