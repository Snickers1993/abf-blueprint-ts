+    `ensure` (abfc) creates a missing component and modifies an existing one. `values` are field-default JSON values (field_value)."""
     ss = _subsystem()
     report = []
     for it in items:
         name = it["name"]
         hs = _handles(ss, bp)
         found = [h for h in hs[1:] if _handle_name(ss, h) == name]
+        if found and it.get("ensure"):
+            it = dict(it)
+            it.pop("class", None)
         if it.get("remove"):
             if not found:
                 raise RuntimeError("cannot remove unknown component %s" % name)
@@ -137,6 +179,8 @@ def add_components(bp, items):
         obj = _component_object(ss, h, bp)
         for k, v in (it.get("properties") or {}).items():
             obj.set_editor_property(k, v)
+        for k, v in (it.get("values") or {}).items():
+            set_prop(obj, k, field_value(v))
         for k, expr in (it.get("expressions") or {}).items():
             obj.set_editor_property(k, eval(expr, {"unreal": unreal}, {}))
         report.append({"name": name, "class": it.get("class")})
@@ -182,6 +226,27 @@ def add_function_override(bp, name, defs):
     return core.adopt_graphs(ib, [name], bp)
 
 
+def implements_interface(bp, iface_class):
+    """True when the compiled class implements the interface (its own entry or a parent's)."""
+    LIB.compile_blueprint(bp)
+    icls = must(unreal.load_class(None, iface_class), "interface " + iface_class)
+    cdo = unreal.get_default_object(must(LIB.generated_class(bp), "generated class of " + pth(bp)))
+    return bool(unreal.SystemLibrary.does_implement_interface(cdo, icls))
+
+
+def find_any_graph(bp, name):
+    """A graph of the Blueprint by name, interface graphs included."""
+    g = LIB.find_graph(bp, name)
+    if g is not None:
+        return g
+    pre = pth(bp) + "."
+    for x in unreal.ObjectIterator(unreal.EdGraph):
+        p = pth(x)
+        if p.startswith(pre) and "." not in p[len(pre):] and x.get_name() == name:
+            return x
+    return None
+
+
 def add_interface(bp, iface_class, graphs_text, names):
     """Append an ImplementedInterfaces entry (FBPInterfaceDescription: 8 + 16 bytes) keeping the existing ones."""
